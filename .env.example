# Optional. Without these the site builds from Markdown in src/content/blog/,
# which is the default and needs no configuration at all.
#
# Set both to source content from Contentful instead. See README → "The content
# adapter" for how the fallback works.
CONTENTFUL_SPACE_ID=your_space_id_here
CONTENTFUL_ACCESS_TOKEN=your_delivery_api_token_here
CONTENTFUL_ENVIRONMENT=master
