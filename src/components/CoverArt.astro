---
import { coverGradient } from '../lib/cover-art'
import type { BlogPost } from '../types'

interface Props {
  post: Pick<BlogPost, 'title' | 'tags' | 'cover'>
  class?: string
  /** Set on the LCP image (the featured card) so the browser prioritises it. */
  eager?: boolean
}

const { post, class: className = '', eager = false } = Astro.props
const { from, to, label } = coverGradient(post.tags)
const style = `background-image: linear-gradient(125deg, ${from}, ${to});`
---

{
  post.cover ? (
    <img
      src={post.cover}
      alt=""
      class={`object-cover ${className}`}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      width="800"
      height="450"
    />
  ) : (
    <div class={`cover-art ${className}`} style={style} aria-hidden="true">
      <span class="cover-word">{label}</span>
      <svg class="cover-glow" viewBox="0 0 200 200" preserveAspectRatio="none">
        <circle cx="30" cy="24" r="60" />
      </svg>
    </div>
  )
}

<style>
  .cover-art {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1rem 1.25rem;
  }
  .cover-word {
    position: relative;
    z-index: 1;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.25);
  }
  .cover-glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.35;
    mix-blend-mode: soft-light;
  }
  .cover-glow circle {
    fill: #fff;
    filter: blur(6px);
  }
</style>
