---
import CoverArt from './CoverArt.astro'
import TagList from './TagList.astro'
import type { BlogPost } from '../types'

interface Props {
  post: BlogPost
}
const { post } = Astro.props
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: '2-digit',
  year: 'numeric',
}).format(new Date(post.publishedAt))
---

<article class="surface-card group flex flex-col overflow-hidden">
  <a href={`/blog/${post.slug}`} class="block" aria-label={post.title}>
    <CoverArt post={post} class="h-40 w-full transition-transform duration-500 group-hover:scale-[1.03]" />
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-wide text-base-content/55">
      <span>{formattedDate}</span>
      <span class="text-base-content/30">•</span>
      <span>{post.readingTime}</span>
    </div>
    <h3 class="mt-3 text-2xl leading-snug">
      <a href={`/blog/${post.slug}`} class="transition-colors group-hover:text-primary">
        {post.title}
      </a>
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-base-content/70">
      {post.excerpt}
    </p>
    <div class="mt-auto pt-5">
      <TagList tags={post.tags} linked class="mb-4" />
      <a
        href={`/blog/${post.slug}`}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary"
      >
        Read article
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="transition-transform duration-300 group-hover:translate-x-1">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</article>
