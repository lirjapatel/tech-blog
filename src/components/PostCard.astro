---
import CoverArt from './CoverArt.astro'
import TagList from './TagList.astro'
import { formatDateShort, toISODate } from '../lib/format'
import type { BlogPost } from '../types'

interface Props {
  post: BlogPost
  eager?: boolean
}

const { post, eager = false } = Astro.props
const formattedDate = formatDateShort(post.publishedAt)
---

<!--
  Stretched-link pattern: the title is the only link to the article, and its
  ::after overlay makes the whole card clickable. Screen-reader users hear one
  link per card instead of three pointing at the same URL.
-->
<article class="surface-card group relative flex flex-col overflow-hidden">
  <CoverArt
    post={post}
    eager={eager}
    class="h-40 w-full transition-transform duration-500 group-hover:scale-[1.03]"
  />
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-wide text-base-content/70">
      <time datetime={toISODate(post.publishedAt)}>{formattedDate}</time>
      <span class="text-base-content/70" aria-hidden="true">•</span>
      <span>{post.readingTime}</span>
    </div>

    <h3 class="mt-3 text-2xl leading-snug">
      <a href={`/blog/${post.slug}/`} class="stretched-link transition-colors group-hover:text-primary">
        {post.title}
      </a>
    </h3>

    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-base-content/70">
      {post.excerpt}
    </p>

    <div class="mt-auto pt-5">
      <TagList tags={post.tags} linked class="relative z-10 mb-4" />
      <span
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary"
        aria-hidden="true"
      >
        Read article
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          <path
            d="M5 12h14M13 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    </div>
  </div>
</article>

<style>
  .stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
</style>
