---
import '../styles/global.css'
import SearchDialog from '../components/SearchDialog.jsx'
import { SITE, NAV } from '../consts'

interface Props {
  title?: string
  description?: string
  /** Absolute or root-relative social card. Defaults to the generated site card. */
  image?: string
  /** Present on article pages; drives BlogPosting structured data. */
  article?: {
    publishedAt: string
    tags: string[]
    readingTime: string
  }
  breadcrumbs?: { name: string; href: string }[]
}

const {
  title = `${SITE.author} — ${SITE.role}`,
  description = SITE.description,
  image = '/og-default.png',
  article,
  breadcrumbs = [],
} = Astro.props

// astro.config.mjs always sets `site`, resolved from the deploy environment.
const siteOrigin = Astro.site!.origin
const canonical = new URL(Astro.url.pathname, siteOrigin).href
const socialImage = new URL(image, siteOrigin).href
const year = new Date().getFullYear()
const pathname = Astro.url.pathname

const isCurrent = (href: string) => {
  const [base] = href.split('#')
  if (base === '/' || base === '') return pathname === '/' && !href.includes('#')
  return pathname === base || pathname.startsWith(`${base}/`)
}

/**
 * Structured data. `WebSite` on every page (enables the sitelinks search box),
 * plus `BlogPosting` and `BreadcrumbList` where they apply.
 */
const schema: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${siteOrigin}/#website`,
    url: `${siteOrigin}/`,
    name: SITE.title,
    description: SITE.description,
    inLanguage: 'en',
    publisher: { '@id': `${siteOrigin}/#person` },
  },
  {
    '@type': 'Person',
    '@id': `${siteOrigin}/#person`,
    name: SITE.author,
    jobTitle: SITE.role,
    email: SITE.email,
    url: `${siteOrigin}/`,
    sameAs: [SITE.social.github, SITE.social.linkedin],
  },
]

if (article) {
  schema.push({
    '@type': 'BlogPosting',
    '@id': `${canonical}#article`,
    headline: title.split(' — ')[0],
    description,
    image: socialImage,
    datePublished: new Date(article.publishedAt).toISOString(),
    dateModified: new Date(article.publishedAt).toISOString(),
    keywords: article.tags.join(', '),
    articleSection: article.tags[0],
    inLanguage: 'en',
    mainEntityOfPage: canonical,
    author: { '@id': `${siteOrigin}/#person` },
    publisher: { '@id': `${siteOrigin}/#person` },
  })
}

if (breadcrumbs.length > 0) {
  schema.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, siteOrigin).href,
    })),
  })
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })
---

<!doctype html>
<html lang="en" data-theme="blog">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D9488" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {article && <meta property="article:published_time" content={new Date(article.publishedAt).toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <!--
      Applies the stored theme before first paint so dark-mode readers never see
      a white flash. Must stay inline and render-blocking.
    -->
    <script is:inline>
      ;(function () {
        try {
          const stored = localStorage.getItem('theme')
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.setAttribute(
            'data-theme',
            stored || (prefersDark ? 'blogdark' : 'blog'),
          )
        } catch (e) {}
      })()
    </script>
  </head>
  <body class="min-h-screen text-base-content">
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-base-content/10 bg-base-100/70 backdrop-blur-xl">
      <nav class="shell flex items-center justify-between gap-4 px-6 py-4 md:px-10 lg:px-16" aria-label="Main">
        <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE.author} — home`}>
          <span
            class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-primary to-secondary font-display text-lg font-semibold text-primary-content shadow-md"
            aria-hidden="true">L</span
          >
          <span class="font-display text-lg font-semibold tracking-tight">{SITE.author}</span>
        </a>

        <div class="flex items-center gap-1 md:gap-2">
          <ul class="hidden items-center gap-1 sm:flex">
            {
              NAV.map((item) => (
                <li>
                  <a
                    class="nav-link"
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <button
            type="button"
            class="search-trigger"
            data-search-open
            aria-label="Search articles"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path
                d="m20 20-3.5-3.5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              /></svg
            >
            <span class="hidden lg:inline">Search</span>
            <kbd class="search-kbd hidden lg:inline-flex" aria-hidden="true">⌘K</kbd>
          </button>

          <button id="theme-toggle" class="icon-button" aria-label="Toggle dark mode" type="button">
            <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path
                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              /></svg
            >
            <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" /><path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              /></svg
            >
          </button>

          <!--
            Mobile drawer trigger. Uses a native <dialog> rather than a UI
            library: focus trapping, Escape-to-close and background inertness
            come from the platform, and it costs no JavaScript bundle.
          -->
          <button
            type="button"
            class="icon-button sm:hidden"
            aria-label="Open menu"
            aria-haspopup="dialog"
            data-nav-open
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path
                d="M4 7h16M4 12h16M4 17h16"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              /></svg
            >
          </button>
        </div>
      </nav>
    </header>

    <dialog id="mobile-nav" class="nav-drawer sm:hidden" aria-label="Site menu">
      <div class="flex items-center justify-between border-b border-base-content/10 px-5 py-4">
        <span class="font-display text-lg font-semibold">Menu</span>
        <button type="button" class="icon-button" aria-label="Close menu" data-nav-close>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg
          >
        </button>
      </div>
      <ul class="flex flex-col gap-1 p-4">
        {
          NAV.map((item) => (
            <li>
              <a
                class="block rounded-lg px-3 py-2.5 text-base font-medium text-base-content/80 transition-colors hover:bg-base-content/5 hover:text-primary"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="mt-2 border-t border-base-content/10 pt-2">
          <a
            class="block rounded-lg px-3 py-2.5 text-base font-medium text-base-content/80 transition-colors hover:bg-base-content/5 hover:text-primary"
            href="/rss.xml">RSS feed</a
          >
        </li>
        <li>
          <a
            class="block rounded-lg px-3 py-2.5 text-base font-medium text-base-content/80 transition-colors hover:bg-base-content/5 hover:text-primary"
            href={SITE.social.github}
            target="_blank"
            rel="noreferrer">GitHub</a
          >
        </li>
      </ul>
    </dialog>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="mt-10 border-t border-base-content/10">
      <div class="shell grid gap-8 px-6 py-14 md:grid-cols-[1.5fr,1fr,1fr] md:px-10 lg:px-16">
        <div>
          <a href="/" class="font-display text-xl font-semibold">{SITE.author}</a>
          <p class="mt-3 max-w-sm text-sm text-base-content/75">{SITE.tagline}</p>
        </div>
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/70">Explore</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="link-underline" href="/blog">All essays</a></li>
            <li><a class="link-underline" href="/#topics">Topics</a></li>
            <li><a class="link-underline" href="/about">About</a></li>
            <li><a class="link-underline" href="/editing">Editor's guide</a></li>
            <li><a class="link-underline" href="/rss.xml">RSS feed</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/70">Elsewhere</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="link-underline" href={SITE.social.github} target="_blank" rel="noreferrer">GitHub</a></li>
            <li><a class="link-underline" href={SITE.social.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></li>
            <li><a class="link-underline" href={`mailto:${SITE.email}`}>Email</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-base-content/10">
        <div class="shell flex flex-col gap-2 px-6 py-6 text-xs text-base-content/70 md:flex-row md:items-center md:justify-between md:px-10 lg:px-16">
          <span>© {year} {SITE.author}. Built with Astro, React islands & a headless CMS.</span>
          <span>Statically generated · Deployed on Netlify</span>
        </div>
      </div>
    </footer>

    <SearchDialog client:idle />

    <script is:inline>
      // Mobile navigation drawer. `showModal()` gives focus trapping, Escape
      // handling and an inert background with no library involved.
      ;(function () {
        const drawer = document.getElementById('mobile-nav')
        if (!drawer) return

        const openButton = document.querySelector('[data-nav-open]')
        const closeButton = drawer.querySelector('[data-nav-close]')

        openButton?.addEventListener('click', () => drawer.showModal())
        closeButton?.addEventListener('click', () => drawer.close())

        // Clicking the backdrop (the dialog element itself) closes the drawer.
        drawer.addEventListener('click', (event) => {
          if (event.target === drawer) drawer.close()
        })
      })()
    </script>

    <script is:inline>
      // Theme toggle — writes through to localStorage so the inline head script
      // can restore it on the next page load.
      const toggle = document.getElementById('theme-toggle')
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.getAttribute('data-theme') === 'blogdark'
          const next = isDark ? 'blog' : 'blogdark'
          document.documentElement.setAttribute('data-theme', next)
          toggle.setAttribute('aria-pressed', String(!isDark))
          try {
            localStorage.setItem('theme', next)
          } catch (e) {}
        })
      }

      // Reveal-on-scroll. Falls back to "everything visible" when
      // IntersectionObserver is unavailable or motion is reduced, so content is
      // never trapped behind an animation that will not run.
      ;(function () {
        const elements = document.querySelectorAll('.reveal')
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        if (reduced || !('IntersectionObserver' in window)) {
          elements.forEach((el) => el.classList.add('is-visible'))
          return
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible')
                observer.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        )
        elements.forEach((el) => observer.observe(el))
      })()
    </script>
  </body>
</html>
