---
import '../styles/global.css'
import { SITE, NAV } from '../consts'

interface Props {
  title?: string
  description?: string
}

const { title = SITE.title, description = SITE.description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en" data-theme="blog">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D9488" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme')
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.setAttribute(
            'data-theme',
            stored || (prefersDark ? 'blogdark' : 'blog'),
          )
        } catch (e) {}
      })()
    </script>
  </head>
  <body class="min-h-screen text-base-content">
    <header class="sticky top-0 z-40 border-b border-base-content/10 bg-base-100/70 backdrop-blur-xl">
      <nav class="shell flex items-center justify-between px-6 py-4 md:px-10 lg:px-16">
        <a href="/" class="group flex items-center gap-2.5">
          <span
            class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-primary to-secondary font-display text-lg font-semibold text-primary-content shadow-md"
            >L</span
          >
          <span class="font-display text-lg font-semibold tracking-tight">{SITE.author}</span>
        </a>

        <div class="flex items-center gap-1 md:gap-2">
          <div class="hidden items-center gap-1 sm:flex">
            {
              NAV.map((item) => (
                <a class="rounded-lg px-3 py-2 text-sm font-medium text-base-content/75 transition-colors hover:bg-base-content/5 hover:text-primary" href={item.href}>
                  {item.label}
                </a>
              ))
            }
          </div>
          <a
            class="hidden rounded-lg px-3 py-2 text-sm font-medium text-base-content/75 transition-colors hover:bg-base-content/5 hover:text-primary sm:block"
            href="/rss.xml">RSS</a
          >
          <a
            class="theme-toggle"
            href={SITE.social.github}
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
              /></svg
            >
          </a>
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" type="button">
            <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none"
              ><path
                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              /></svg
            >
            <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none"
              ><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" /><path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              /></svg
            >
          </button>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-10 border-t border-base-content/10">
      <div class="shell grid gap-8 px-6 py-14 md:grid-cols-[1.5fr,1fr,1fr] md:px-10 lg:px-16">
        <div>
          <a href="/" class="font-display text-xl font-semibold">{SITE.author}</a>
          <p class="mt-3 max-w-sm text-sm text-base-content/65">{SITE.tagline}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Explore</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="link-underline" href="/#writing">Writing</a></li>
            <li><a class="link-underline" href="/#topics">Topics</a></li>
            <li><a class="link-underline" href="/about">About</a></li>
            <li><a class="link-underline" href="/rss.xml">RSS feed</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Elsewhere</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="link-underline" href={SITE.social.github} target="_blank" rel="noreferrer">GitHub</a></li>
            <li><a class="link-underline" href={SITE.social.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></li>
            <li><a class="link-underline" href={`mailto:${SITE.email}`}>Email</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-base-content/10">
        <div class="shell flex flex-col gap-2 px-6 py-6 text-xs text-base-content/55 md:flex-row md:items-center md:justify-between md:px-10 lg:px-16">
          <span>© {year} {SITE.author}. Built with Astro, React islands & Contentful.</span>
          <span>Static-generated. Deployed on Netlify.</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Theme toggle
      const tt = document.getElementById('theme-toggle')
      if (tt) {
        tt.addEventListener('click', () => {
          const dark = document.documentElement.getAttribute('data-theme') === 'blogdark'
          const next = dark ? 'blog' : 'blogdark'
          document.documentElement.setAttribute('data-theme', next)
          try {
            localStorage.setItem('theme', next)
          } catch (e) {}
        })
      }

      // Reveal on scroll
      const reveal = () => {
        const els = document.querySelectorAll('.reveal')
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'))
          return
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible')
                io.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        )
        els.forEach((el) => io.observe(el))
      }
      reveal()
    </script>
  </body>
</html>
