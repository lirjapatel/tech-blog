---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { getAllTags, getPostsByTag } from '../../lib/posts'
import { SITE } from '../../consts'
import type { BlogPost } from '../../types'

export async function getStaticPaths() {
  const tags = await getAllTags()
  return Promise.all(
    tags.map(async ({ tag, slug }) => ({
      params: { tag: slug },
      props: { tag, posts: await getPostsByTag(slug) },
    })),
  )
}

const { tag, posts } = Astro.props as { tag: string; posts: BlogPost[] }
---

<BaseLayout
  title={`${tag} — ${SITE.author}`}
  description={`${posts.length} ${posts.length === 1 ? 'essay' : 'essays'} on ${tag} by ${SITE.author}.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Writing', href: '/blog' },
    { name: tag, href: `/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/` },
  ]}
>
  <section class="section-pad pt-20 md:pt-24" aria-labelledby="tag-heading">
    <div class="shell">
      <nav aria-label="Breadcrumb">
        <a class="link-underline text-sm" href="/blog">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path
              d="M19 12H5M11 6l-6 6 6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            /></svg
          >
          All writing
        </a>
      </nav>

      <p class="eyebrow mt-6 block">Topic</p>
      <h1 id="tag-heading" class="mt-2 font-display text-5xl tracking-tight md:text-6xl">{tag}</h1>
      <p class="mt-3 text-base-content/65">
        {posts.length}
        {posts.length === 1 ? 'essay' : 'essays'} on {tag.toLowerCase()}.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post, index) => (
            <div class="reveal" style={`transition-delay:${(index % 3) * 80}ms`}>
              <PostCard post={post} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
