---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { getAllPosts } from '../../lib/contentful'
import { SITE } from '../../consts'

export async function getStaticPaths() {
  const slugify = (t: string) => t.toLowerCase().replace(/\s+/g, '-')
  const posts = await getAllPosts()
  const tags = [...new Set(posts.flatMap((p) => p.tags))]
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: {
      tag,
      posts: posts.filter((p) => p.tags.includes(tag)),
    },
  }))
}

const { tag, posts } = Astro.props
---

<BaseLayout title={`${tag} — ${SITE.author}`} description={`Essays tagged ${tag}.`}>
  <section class="section-pad pt-20 md:pt-24">
    <div class="shell">
      <a class="link-underline text-sm" href="/#topics">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
          ><path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg
        >
        All topics
      </a>
      <span class="eyebrow mt-6 block">Topic</span>
      <h1 class="mt-2 font-display text-5xl tracking-tight md:text-6xl">{tag}</h1>
      <p class="mt-3 text-base-content/65">
        {posts.length} {posts.length === 1 ? 'essay' : 'essays'} on {tag.toLowerCase()}.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post, i) => (
            <div class="reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
              <PostCard post={post} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
