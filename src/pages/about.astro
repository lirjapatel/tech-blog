---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getAllTags } from '../lib/posts'
import { SITE } from '../consts'

const topics = await getAllTags()

const focus = [
  {
    title: 'AI product experiences',
    body: 'Grounded assistants and prompt design that stay honest, fast, and useful — not gimmicks.',
  },
  {
    title: 'Interfaces under real data',
    body: 'Dashboards and tables that stay smooth and legible when the demo data turns into a firehose.',
  },
  {
    title: 'Fast content sites',
    body: 'Astro islands and headless CMS workflows that ship near-zero JavaScript by default.',
  },
  {
    title: 'Shipping to the cloud',
    body: 'Reproducible builds, sensible caching, and deploy pipelines that stay boring on purpose.',
  },
]

const stack = [
  'Astro',
  'React',
  'TypeScript',
  'Tailwind CSS',
  'Preline',
  'daisyUI',
  'Contentful',
  'Decap CMS',
  'Playwright',
  'Node.js',
  'Netlify',
  'Python',
]

/**
 * How AI tooling actually fits into the workflow. Written as concrete practice
 * rather than a badge — the interesting part is where it is *not* trusted.
 */
const aiWorkflow = [
  {
    title: 'Scaffold, then rewrite',
    body: 'I use agents to draft a component or a test file, then rewrite anything I would not have written myself. Generated code that nobody can explain is a liability, not a shortcut.',
  },
  {
    title: 'Edge cases I would have missed',
    body: 'Asking a model to attack my own test suite is where it earns its keep — reduced-motion users, an empty search index, a CMS that returns nothing. Several tests in this repo started that way.',
  },
  {
    title: 'Reviewing accessibility out loud',
    body: 'Pasting markup in and asking "what breaks for a screen reader here?" catches things faster than reading WCAG cold. Then axe-core verifies it in CI, because a model saying it is fine proves nothing.',
  },
  {
    title: 'Documentation that stays current',
    body: 'The editor guide on this site was drafted by an agent from the CMS config, then corrected by hand. Regenerating it when the schema changes takes minutes instead of never happening.',
  },
]
---

<BaseLayout
  title={`About — ${SITE.author}`}
  description={SITE.bio}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'About', href: '/about' },
  ]}
>
  <section class="section-pad pt-20 md:pt-28" aria-labelledby="about-heading">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[1.1fr,0.9fr] lg:items-start">
        <div class="animate-fade-up">
          <p class="eyebrow">About</p>
          <h1
            id="about-heading"
            class="mt-4 font-display text-5xl leading-[1.05] tracking-tight md:text-6xl"
          >
            Hi, I&apos;m {SITE.author}.
          </h1>
          <p class="mt-6 text-xl leading-relaxed text-base-content/75">{SITE.bio}</p>
          <p class="mt-4 text-base leading-relaxed text-base-content/75">
            I gravitate toward the seams of a product — the moment an API is slow, the table has ten
            thousand rows, or the design needs to survive contact with real content. This blog is
            where I write down what worked, what didn&apos;t, and why.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn-primary" href={`mailto:${SITE.email}`}>Get in touch</a>
            <a class="btn btn-ghost" href={SITE.social.github} target="_blank" rel="noreferrer"
              >GitHub</a
            >
            <a class="btn btn-ghost" href={SITE.social.linkedin} target="_blank" rel="noreferrer"
              >LinkedIn</a
            >
          </div>
        </div>

        <div class="glass-panel animate-fade-up p-8" style="animation-delay:120ms">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/70">
            Tools I reach for
          </h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {stack.map((item) => <li class="chip">{item}</li>)}
          </ul>
          <h2 class="mt-8 text-xs font-semibold uppercase tracking-wider text-base-content/70">
            I write about
          </h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              topics.map(({ tag, slug }) => (
                <li>
                  <a class="chip" href={`/tags/${slug}/`}>
                    {tag}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad pt-6" aria-labelledby="focus-heading">
    <div class="shell">
      <h2 id="focus-heading" class="sr-only">What I focus on</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          focus.map((item, index) => (
            <div class="reveal surface-card p-7" style={`transition-delay:${(index % 2) * 80}ms`}>
              <span
                class="grid h-10 w-10 place-items-center rounded-xl bg-primary/10 font-display text-lg font-semibold text-primary"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <h3 class="mt-4 font-display text-xl">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-base-content/70">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How AI fits into the workflow -->
  <section class="section-pad pt-6" aria-labelledby="ai-heading">
    <div class="shell reveal">
      <div class="glass-panel p-8 md:p-10">
        <p class="eyebrow">Working with AI</p>
        <h2 id="ai-heading" class="mt-2 font-display text-3xl">How I actually use AI agents</h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-base-content/70">
          This site was built with an AI agent in the loop the whole way. That is worth being
          specific about, because &ldquo;used AI&rdquo; on its own says nothing about whether the
          result is any good.
        </p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {
            aiWorkflow.map((item) => (
              <div>
                <h3 class="font-display text-lg">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-base-content/70">{item.body}</p>
              </div>
            ))
          }
        </div>

        <p class="mt-8 border-t border-base-content/10 pt-6 text-sm leading-relaxed text-base-content/75">
          The rule I hold to: an agent can draft anything, but nothing ships that I can&apos;t
          explain line by line. Everything here is covered by a Playwright suite that runs in CI —
          including automated accessibility checks — so the quality bar is enforced by something
          other than my own confidence.
        </p>
      </div>
    </div>
  </section>

  <section class="section-pad pt-0" aria-labelledby="contact-heading">
    <div class="shell reveal">
      <div
        class="glass-panel flex flex-col items-start gap-4 p-8 md:flex-row md:items-center md:justify-between md:p-10"
      >
        <div>
          <h2 id="contact-heading" class="font-display text-3xl">Want to work together?</h2>
          <p class="mt-2 text-sm text-base-content/70">
            I&apos;m open to frontend and product engineering work. The fastest way to reach me is
            email.
          </p>
        </div>
        <a class="btn btn-primary" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>
