---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { getAllPosts, getAllTags } from '../../lib/posts'
import { getYear } from '../../lib/format'
import { SITE } from '../../consts'

const posts = await getAllPosts()
const tags = await getAllTags()

/** Group by year so the archive reads as a timeline rather than an endless grid. */
const byYear = posts.reduce<Map<number, typeof posts>>((groups, post) => {
  const year = getYear(post.publishedAt)
  const bucket = groups.get(year) ?? []
  bucket.push(post)
  groups.set(year, bucket)
  return groups
}, new Map())

const years = [...byYear.keys()].sort((a, b) => b - a)
---

<BaseLayout
  title={`Writing — ${SITE.author}`}
  description={`Every essay by ${SITE.author} on frontend engineering, Astro, AI product design, performance, and deployment.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Writing', href: '/blog' },
  ]}
>
  <section class="section-pad pt-20 md:pt-24" aria-labelledby="archive-heading">
    <div class="shell">
      <p class="eyebrow">The archive</p>
      <h1 id="archive-heading" class="mt-2 font-display text-5xl tracking-tight md:text-6xl">
        Writing
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-base-content/70">
        {posts.length} essays across {tags.length} topics. Everything here comes from real projects —
        including the parts that did not work.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-2.5">
        <button type="button" class="chip text-sm" data-search-open>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="mr-1.5" aria-hidden="true"
            ><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path
              d="m20 20-3.5-3.5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            /></svg
          >
          Search
        </button>
        {
          tags.map(({ tag, slug, count }) => (
            <a href={`/tags/${slug}/`} class="chip text-sm">
              {tag}
              <span class="ml-2 text-base-content/70">{count}</span>
            </a>
          ))
        }
      </div>

      {
        years.map((year) => (
          <section class="mt-16" aria-labelledby={`year-${year}`}>
            <div class="flex items-center gap-4">
              <h2 id={`year-${year}`} class="font-display text-2xl text-base-content/70">
                {year}
              </h2>
              <span class="h-px flex-1 bg-base-content/10" aria-hidden="true" />
              <span class="text-sm text-base-content/70">
                {byYear.get(year)!.length} {byYear.get(year)!.length === 1 ? 'essay' : 'essays'}
              </span>
            </div>

            <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {byYear.get(year)!.map((post, index) => (
                <div class="reveal" style={`transition-delay:${(index % 3) * 80}ms`}>
                  <PostCard post={post} />
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
