---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CoverArt from '../../components/CoverArt.astro'
import PostCard from '../../components/PostCard.astro'
import TagList from '../../components/TagList.astro'
import TableOfContents from '../../components/TableOfContents.astro'
import { getAllPosts, getAdjacentPosts, getRelatedPosts, renderPost } from '../../lib/posts'
import { formatDateLong, toISODate } from '../../lib/format'
import { SITE } from '../../consts'
import type { BlogPost } from '../../types'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

const { post } = Astro.props as { post: BlogPost }

const { Content, html, headings } = await renderPost(post)
const related = await getRelatedPosts(post)
const { newer, older } = await getAdjacentPosts(post)

const formattedDate = formatDateLong(post.publishedAt)

const shareUrl = new URL(`/blog/${post.slug}/`, Astro.site ?? SITE.url).href
---

<BaseLayout
  title={`${post.title} — ${SITE.author}`}
  description={post.excerpt}
  image={`/og/${post.slug}.png`}
  article={{ publishedAt: post.publishedAt, tags: post.tags, readingTime: post.readingTime }}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Writing', href: '/blog' },
    { name: post.title, href: `/blog/${post.slug}/` },
  ]}
>
  <div class="reading-progress" aria-hidden="true"><span id="rp-bar"></span></div>

  <article>
    <!-- Header -->
    <header class="section-pad pb-8 pt-16">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="Breadcrumb">
          <a class="link-underline text-sm" href="/blog">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path
                d="M19 12H5M11 6l-6 6 6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              /></svg
            >
            All writing
          </a>
        </nav>

        <div class="mt-6"><TagList tags={post.tags} linked /></div>
        <h1 class="mt-4 font-display text-4xl leading-[1.1] tracking-tight md:text-5xl">
          {post.title}
        </h1>
        <p class="mt-5 text-lg text-base-content/70">{post.excerpt}</p>

        <div class="mt-8 flex items-center gap-3 border-t border-base-content/10 pt-6">
          <span
            class="grid h-11 w-11 place-items-center rounded-full bg-gradient-to-br from-primary to-secondary font-display font-semibold text-primary-content"
            aria-hidden="true"
          >
            {SITE.author.charAt(0)}
          </span>
          <div class="text-sm">
            <p class="font-semibold">{SITE.author}</p>
            <p class="text-base-content/70">
              <time datetime={toISODate(post.publishedAt)}>{formattedDate}</time>
               · {post.readingTime}
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Cover -->
    <div class="section-pad py-0">
      <div class="mx-auto max-w-4xl">
        <CoverArt post={post} eager class="h-64 w-full rounded-3xl md:h-80" />
      </div>
    </div>

    <!-- Body + table of contents -->
    <div class="section-pad pt-10">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr),15rem] lg:items-start">
        <div class="article-content mx-auto w-full max-w-prose lg:mx-0">
          {Content ? <Content /> : <Fragment set:html={html} />}
        </div>

        <aside class="order-first hidden lg:sticky lg:top-28 lg:order-none lg:block">
          <TableOfContents headings={headings} />
        </aside>
      </div>

      <div class="mx-auto mt-12 max-w-prose border-t border-base-content/10 pt-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <TagList tags={post.tags} linked />
          <div class="flex items-center gap-3 text-sm">
            <span class="text-base-content/70">Share</span>
            <a
              class="icon-button"
              aria-label={`Share "${post.title}" on LinkedIn`}
              target="_blank"
              rel="noreferrer"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path
                  d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5ZM3 9h4v12H3V9Zm6 0h3.8v1.64h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H9V9Z"
                /></svg
              >
            </a>
            <button
              type="button"
              class="icon-button"
              data-copy-link
              data-url={shareUrl}
              aria-label="Copy link to this article"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                ><path
                  d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.4M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07l1.3-1.3"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                /></svg
              >
            </button>
          </div>
        </div>
        <p class="mt-3 text-right text-xs text-base-content/70" role="status" data-copy-status></p>
      </div>
    </div>
  </article>

  <!-- Previous / next -->
  {
    (newer || older) && (
      <nav class="section-pad pt-0" aria-label="More articles">
        <div class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-2">
          {older ? (
            <a href={`/blog/${older.slug}/`} class="surface-card group p-6">
              <span class="text-xs uppercase tracking-wider text-base-content/70">
                ← Older essay
              </span>
              <span class="mt-2 block font-display text-lg leading-snug transition-colors group-hover:text-primary">
                {older.title}
              </span>
            </a>
          ) : (
            <div />
          )}
          {newer && (
            <a href={`/blog/${newer.slug}/`} class="surface-card group p-6 sm:text-right">
              <span class="text-xs uppercase tracking-wider text-base-content/70">
                Newer essay →
              </span>
              <span class="mt-2 block font-display text-lg leading-snug transition-colors group-hover:text-primary">
                {newer.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )
  }

  <!-- Author card -->
  <section class="section-pad pt-0" aria-label="About the author">
    <div class="reveal mx-auto max-w-4xl">
      <div class="glass-panel flex flex-col gap-5 p-8 sm:flex-row sm:items-center">
        <span
          class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-primary to-secondary font-display text-2xl font-semibold text-primary-content"
          aria-hidden="true"
        >
          {SITE.author.charAt(0)}
        </span>
        <div class="flex-1">
          <p class="font-display text-xl font-semibold">{SITE.author}</p>
          <p class="mt-2 text-sm leading-relaxed text-base-content/70">{SITE.bio}</p>
        </div>
        <a class="btn btn-primary btn-sm shrink-0" href="/about">About</a>
      </div>
    </div>
  </section>

  <!-- Related -->
  {
    related.length > 0 && (
      <section class="section-pad pt-0" aria-labelledby="related-heading">
        <div class="shell reveal">
          <h2 id="related-heading" class="font-display text-3xl">
            Keep reading
          </h2>
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {related.map((entry) => (
              <PostCard post={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <script>
    // Reading progress bar.
    const bar = document.getElementById('rp-bar')
    if (bar) {
      const onScroll = () => {
        const root = document.documentElement
        const max = root.scrollHeight - root.clientHeight
        bar.style.width = `${max > 0 ? (root.scrollTop / max) * 100 : 0}%`
      }
      document.addEventListener('scroll', onScroll, { passive: true })
      onScroll()
    }

    // Copy-link button. Announced via a role="status" region so screen readers
    // hear the confirmation instead of only seeing it.
    const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]')
    const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]')

    copyButton?.addEventListener('click', async () => {
      const url = copyButton.dataset.url ?? window.location.href
      try {
        await navigator.clipboard.writeText(url)
        if (copyStatus) copyStatus.textContent = 'Link copied to clipboard'
      } catch {
        if (copyStatus) copyStatus.textContent = 'Could not copy — press Ctrl+C to copy the URL'
      }
      window.setTimeout(() => {
        if (copyStatus) copyStatus.textContent = ''
      }, 3000)
    })
  </script>
</BaseLayout>
