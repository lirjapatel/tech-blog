---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CoverArt from '../../components/CoverArt.astro'
import PostCard from '../../components/PostCard.astro'
import TagList from '../../components/TagList.astro'
import { getAllPosts, getPostBySlug } from '../../lib/contentful'
import { SITE } from '../../consts'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post) => ({ params: { slug: post.slug } }))
}

const { slug } = Astro.params
const post = await getPostBySlug(slug)

if (!post) {
  throw new Error(`Post not found: ${slug}`)
}

const all = await getAllPosts()
const related = all
  .filter((p) => p.id !== post.id && p.tags.some((t) => post.tags.includes(t)))
  .slice(0, 3)

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: '2-digit',
  year: 'numeric',
}).format(new Date(post.publishedAt))
---

<BaseLayout title={`${post.title} — ${SITE.author}`} description={post.excerpt}>
  <div class="reading-progress"><span id="rp-bar"></span></div>

  <article>
    <!-- Header -->
    <header class="section-pad pb-8 pt-16">
      <div class="mx-auto max-w-3xl">
        <a class="link-underline text-sm" href="/#writing">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
            ><path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg
          >
          All writing
        </a>
        <div class="mt-6"><TagList tags={post.tags} linked /></div>
        <h1 class="mt-4 font-display text-4xl leading-[1.1] tracking-tight md:text-5xl">
          {post.title}
        </h1>
        <p class="mt-5 text-lg text-base-content/70">{post.excerpt}</p>

        <div class="mt-8 flex items-center gap-3 border-t border-base-content/10 pt-6">
          <span class="grid h-11 w-11 place-items-center rounded-full bg-gradient-to-br from-primary to-secondary font-display font-semibold text-primary-content">
            {SITE.author.charAt(0)}
          </span>
          <div class="text-sm">
            <p class="font-semibold">{SITE.author}</p>
            <p class="text-base-content/55">{formattedDate} · {post.readingTime}</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Cover -->
    <div class="section-pad py-0">
      <div class="mx-auto max-w-4xl">
        <CoverArt post={post} class="h-64 w-full rounded-3xl md:h-80" />
      </div>
    </div>

    <!-- Body -->
    <div class="section-pad pt-10">
      <div class="article-content mx-auto max-w-prose" set:html={post.body} />

      <div class="mx-auto mt-12 max-w-prose border-t border-base-content/10 pt-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <TagList tags={post.tags} linked />
          <div class="flex items-center gap-3 text-sm">
            <span class="text-base-content/55">Share</span>
            <a
              class="theme-toggle"
              aria-label="Share on LinkedIn"
              target="_blank"
              rel="noreferrer"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${SITE.url}/blog/${post.slug}`}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
                ><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5ZM3 9h4v12H3V9Zm6 0h3.8v1.64h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H9V9Z" /></svg
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Author card -->
  <section class="section-pad pt-0">
    <div class="mx-auto max-w-4xl reveal">
      <div class="glass-panel flex flex-col gap-5 p-8 sm:flex-row sm:items-center">
        <span class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-primary to-secondary font-display text-2xl font-semibold text-primary-content">
          {SITE.author.charAt(0)}
        </span>
        <div class="flex-1">
          <p class="font-display text-xl font-semibold">{SITE.author}</p>
          <p class="mt-2 text-sm leading-relaxed text-base-content/70">{SITE.bio}</p>
        </div>
        <a class="btn btn-primary btn-sm shrink-0" href="/about">About</a>
      </div>
    </div>
  </section>

  <!-- Related -->
  {
    related.length > 0 && (
      <section class="section-pad pt-0">
        <div class="shell reveal">
          <h2 class="font-display text-3xl">Keep reading</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <script is:inline>
    const bar = document.getElementById('rp-bar')
    if (bar) {
      const onScroll = () => {
        const h = document.documentElement
        const max = h.scrollHeight - h.clientHeight
        bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%'
      }
      document.addEventListener('scroll', onScroll, { passive: true })
      onScroll()
    }
  </script>
</BaseLayout>
