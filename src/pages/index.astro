---
import BaseLayout from '../layouts/BaseLayout.astro'
import NewsletterSignup from '../components/NewsletterSignup.jsx'
import PostCard from '../components/PostCard.astro'
import CoverArt from '../components/CoverArt.astro'
import TagList from '../components/TagList.astro'
import { getAllPosts, getAllTags } from '../lib/posts'
import { formatDateShort, toISODate } from '../lib/format'
import { SITE } from '../consts'

const posts = await getAllPosts()
const tags = await getAllTags()

const featured = posts.find((post) => post.featured) ?? posts[0]
const rest = posts.filter((post) => post.id !== featured?.id).slice(0, 6)

const featuredDate = featured ? formatDateShort(featured.publishedAt) : ''
---

<BaseLayout title={`${SITE.author} — ${SITE.role}`} description={SITE.description}>
  <!-- Hero -->
  <section class="section-pad pb-10 pt-20 md:pt-28" aria-labelledby="hero-heading">
    <div class="shell">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr,0.85fr]">
        <div class="animate-fade-up">
          <p class="chip">
            <span
              class="mr-2 inline-block h-2 w-2 animate-pulse rounded-full bg-success"
              aria-hidden="true"></span>
            Available for frontend work
          </p>
          <h1
            id="hero-heading"
            class="mt-6 font-display text-5xl leading-[1.05] tracking-tight md:text-6xl lg:text-7xl"
          >
            Building calm, <span class="gradient-text">fast</span> software
            <span class="text-base-content/60">— and writing it down.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-base-content/70">
            I&apos;m {SITE.author}, a {SITE.role.toLowerCase()} working on AI assistants, data
            dashboards, and content-driven sites. These are my field notes on React, Astro,
            performance, and shipping to the cloud.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a class="btn btn-primary" href="#writing">
              Read the writing
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                ><path
                  d="M5 12h14M13 6l6 6-6 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                /></svg
              >
            </a>
            <a class="btn btn-ghost" href="/about">About me</a>
          </div>
          <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-base-content/10 pt-6">
            <div>
              <dt class="text-xs uppercase tracking-wide text-base-content/70">Essays</dt>
              <dd class="order-first font-display text-3xl font-semibold text-primary">
                {posts.length}
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-base-content/70">Topics</dt>
              <dd class="order-first font-display text-3xl font-semibold text-primary">
                {tags.length}
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-base-content/70">JS by default</dt>
              <dd class="order-first font-display text-3xl font-semibold text-primary">0 KB</dd>
            </div>
          </dl>
        </div>

        <!-- Featured card -->
        {
          featured && (
            <article
              class="surface-card group relative block animate-fade-up overflow-hidden"
              style="animation-delay:120ms"
            >
              <CoverArt
                post={featured}
                eager
                class="h-56 w-full transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <div class="p-7">
                <p class="eyebrow">Featured</p>
                <h2 class="mt-3 font-display text-3xl leading-tight transition-colors group-hover:text-primary">
                  <a href={`/blog/${featured.slug}/`} class="stretched-link">
                    {featured.title}
                  </a>
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-base-content/70">{featured.excerpt}</p>
                <p class="mt-5 flex items-center gap-3 text-xs uppercase tracking-wide text-base-content/70">
                  <time datetime={toISODate(featured.publishedAt)}>{featuredDate}</time>
                  <span class="text-base-content/70" aria-hidden="true">
                    •
                  </span>
                  <span>{featured.readingTime}</span>
                </p>
              </div>
            </article>
          )
        }
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="section-pad" id="writing" aria-labelledby="writing-heading">
    <div class="shell">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">The archive</p>
          <h2 id="writing-heading" class="mt-2 font-display text-4xl">Latest writing</h2>
        </div>
        <p class="max-w-sm text-sm text-base-content/70">
          Practical notes from real projects — grounded, opinionated, and honest about the
          trade-offs.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((post, index) => (
            <div class="reveal" style={`transition-delay:${(index % 3) * 80}ms`}>
              <PostCard post={post} />
            </div>
          ))
        }
      </div>

      <div class="reveal mt-10 flex justify-center">
        <a class="btn btn-outline" href="/blog">Browse all {posts.length} essays</a>
      </div>
    </div>
  </section>

  <!-- Topics -->
  <section class="section-pad pt-0" id="topics" aria-labelledby="topics-heading">
    <div class="shell reveal">
      <div class="glass-panel p-8 md:p-10">
        <p class="eyebrow">Browse by topic</p>
        <h2 id="topics-heading" class="mt-2 font-display text-3xl">What I write about</h2>
        <ul class="mt-6 flex flex-wrap gap-2.5">
          {
            tags.map(({ tag, slug, count }) => (
              <li>
                <a href={`/tags/${slug}/`} class="chip text-sm">
                  {tag}
                  <span class="ml-2 text-base-content/70">{count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section-pad pt-0" aria-labelledby="newsletter-heading">
    <div class="shell reveal">
      <div class="glass-panel grid gap-8 p-8 md:grid-cols-[1.1fr,0.9fr] md:items-center md:p-10">
        <div>
          <p class="eyebrow">React island</p>
          <h2 id="newsletter-heading" class="mt-2 font-display text-3xl">
            Get new essays by email
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-base-content/70">
            This form is a hydrated React island — the rest of the page ships as static HTML.
            Subscribe for new writing on frontend, AI, and performance.
          </p>
        </div>
        <NewsletterSignup client:visible />
      </div>
    </div>
  </section>

  <!--
    Netlify Forms registration.

    Netlify's build step scans the *built HTML* for forms carrying
    `data-netlify`, and registers whatever it finds. The real signup UI is a
    React island that renders in the browser, which the build step never sees —
    so this hidden static twin is what actually registers the form. The island
    then POSTs to it with a matching `form-name`.

    Field names here must match what NewsletterSignup.jsx sends, or Netlify
    rejects the submission.
  -->
  <form
    name="newsletter"
    method="POST"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    hidden
    aria-hidden="true"
    tabindex="-1"
  >
    <input type="hidden" name="form-name" value="newsletter" />
    <input type="email" name="email" />
    <input type="text" name="bot-field" />
  </form>

  <!-- About teaser -->
  <section class="section-pad pt-0" aria-labelledby="about-teaser-heading">
    <div class="shell reveal">
      <div
        class="grid gap-8 rounded-3xl border border-base-content/10 bg-gradient-to-br from-primary/8 via-base-100/40 to-secondary/8 p-8 md:grid-cols-[0.9fr,1.1fr] md:items-center md:p-10"
      >
        <div>
          <p class="eyebrow">About</p>
          <h2 id="about-teaser-heading" class="mt-2 font-display text-3xl">
            {SITE.role} who likes the details
          </h2>
          <p class="mt-4 text-base leading-relaxed text-base-content/75">{SITE.bio}</p>
          <a class="btn btn-outline btn-sm mt-6" href="/about">More about me</a>
        </div>
        <TagList tags={tags.slice(0, 8).map((t) => t.tag)} class="justify-start md:justify-end" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
</style>
