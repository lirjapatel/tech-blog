---
import BaseLayout from '../layouts/BaseLayout.astro'
import NewsletterSignup from '../components/NewsletterSignup.jsx'
import PostCard from '../components/PostCard.astro'
import CoverArt from '../components/CoverArt.astro'
import TagList from '../components/TagList.astro'
import { getAllPosts } from '../lib/contentful'
import { SITE } from '../consts'

const posts = await getAllPosts()
const featured = posts.find((p) => p.featured) ?? posts[0]
const rest = posts.filter((p) => p.id !== featured?.id)
const allTags = [...new Set(posts.flatMap((p) => p.tags))].sort()
const slugify = (t: string) => t.toLowerCase().replace(/\s+/g, '-')

const featuredDate = featured
  ? new Intl.DateTimeFormat('en-US', { month: 'short', day: '2-digit', year: 'numeric' }).format(
      new Date(featured.publishedAt),
    )
  : ''
---

<BaseLayout title={`${SITE.author} — ${SITE.role}`} description={SITE.description}>
  <!-- Hero -->
  <section class="section-pad pb-10 pt-20 md:pt-28">
    <div class="shell">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr,0.85fr]">
        <div class="animate-fade-up">
          <span class="chip">
            <span class="mr-2 inline-block h-2 w-2 animate-pulse rounded-full bg-success"></span>
            Available for frontend work
          </span>
          <h1 class="mt-6 font-display text-5xl leading-[1.05] tracking-tight md:text-6xl lg:text-7xl">
            Building calm, <span class="gradient-text">fast</span> software
            <span class="text-base-content/45">— and writing it down.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-base-content/70">
            I&apos;m {SITE.author}, a {SITE.role.toLowerCase()} working on AI assistants, data
            dashboards, and content-driven sites. These are my field notes on React, Astro,
            performance, and shipping to the cloud.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a class="btn btn-primary" href="#writing">
              Read the writing
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                ><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg
              >
            </a>
            <a class="btn btn-ghost" href="/about">About me</a>
          </div>
          <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-base-content/10 pt-6">
            <div>
              <dt class="font-display text-3xl font-semibold text-primary">{posts.length}</dt>
              <dd class="mt-1 text-xs uppercase tracking-wide text-base-content/55">Essays</dd>
            </div>
            <div>
              <dt class="font-display text-3xl font-semibold text-primary">{allTags.length}</dt>
              <dd class="mt-1 text-xs uppercase tracking-wide text-base-content/55">Topics</dd>
            </div>
            <div>
              <dt class="font-display text-3xl font-semibold text-primary">0 KB</dt>
              <dd class="mt-1 text-xs uppercase tracking-wide text-base-content/55">JS by default</dd>
            </div>
          </dl>
        </div>

        <!-- Featured card -->
        {
          featured && (
            <a
              href={`/blog/${featured.slug}`}
              class="surface-card group relative block animate-fade-up overflow-hidden"
              style="animation-delay:120ms"
            >
              <CoverArt post={featured} class="h-56 w-full transition-transform duration-500 group-hover:scale-[1.03]" />
              <div class="p-7">
                <span class="eyebrow">Featured</span>
                <h2 class="mt-3 font-display text-3xl leading-tight transition-colors group-hover:text-primary">
                  {featured.title}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-base-content/70">{featured.excerpt}</p>
                <div class="mt-5 flex items-center gap-3 text-xs uppercase tracking-wide text-base-content/55">
                  <span>{featuredDate}</span>
                  <span class="text-base-content/30">•</span>
                  <span>{featured.readingTime}</span>
                </div>
              </div>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="section-pad" id="writing">
    <div class="shell">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="eyebrow">The archive</span>
          <h2 class="mt-2 font-display text-4xl">Latest writing</h2>
        </div>
        <p class="max-w-sm text-sm text-base-content/60">
          Practical notes from real projects — grounded, opinionated, and honest about the
          trade-offs.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((post, i) => (
            <div class="reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
              <PostCard post={post} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Topics -->
  <section class="section-pad pt-0" id="topics">
    <div class="shell reveal">
      <div class="glass-panel p-8 md:p-10">
        <span class="eyebrow">Browse by topic</span>
        <h2 class="mt-2 font-display text-3xl">What I write about</h2>
        <div class="mt-6 flex flex-wrap gap-2.5">
          {
            allTags.map((tag) => (
              <a href={`/tags/${slugify(tag)}`} class="chip text-sm">
                {tag}
                <span class="ml-2 text-base-content/40">
                  {posts.filter((p) => p.tags.includes(tag)).length}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section-pad pt-0">
    <div class="shell reveal">
      <div class="glass-panel grid gap-8 p-8 md:grid-cols-[1.1fr,0.9fr] md:items-center md:p-10">
        <div>
          <span class="eyebrow">React island</span>
          <h2 class="mt-2 font-display text-3xl">Get new essays by email</h2>
          <p class="mt-3 text-sm leading-relaxed text-base-content/70">
            This form is a hydrated React island — the rest of the page ships as static HTML.
            Subscribe for new writing on frontend, AI, and performance.
          </p>
        </div>
        <NewsletterSignup client:visible />
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="section-pad pt-0">
    <div class="shell reveal">
      <div class="grid gap-8 rounded-3xl border border-base-content/10 bg-gradient-to-br from-primary/8 via-base-100/40 to-secondary/8 p-8 md:grid-cols-[0.9fr,1.1fr] md:items-center md:p-10">
        <div>
          <span class="eyebrow">About</span>
          <h2 class="mt-2 font-display text-3xl">{SITE.role} who likes the details</h2>
          <p class="mt-4 text-base leading-relaxed text-base-content/75">{SITE.bio}</p>
          <a class="btn btn-outline btn-sm mt-6" href="/about">More about me</a>
        </div>
        <TagList tags={[...allTags].slice(0, 8)} class="justify-start md:justify-end" />
      </div>
    </div>
  </section>
</BaseLayout>
